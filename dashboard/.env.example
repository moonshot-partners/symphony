# Data source for the board: "mock" (local fixtures, default) or "http"
# (BFF route that proxies the Elixir live API). The app runs on "mock"
# with no backend.
NEXT_PUBLIC_DATA_SOURCE=mock

# Real backend (only needed when NEXT_PUBLIC_DATA_SOURCE=http). The Elixir
# read-only cockpit API is served when its host runs with
# SYMPHONY_COCKPIT_API_PORT set. These stay server-side (never shipped to the
# browser).
# COCKPIT_API_URL=http://localhost:4010
# COCKPIT_API_TOKEN=
